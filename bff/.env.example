# FormulaeApps BFF — environment variables
#
# Copy to .env (NEVER commit .env) and fill with real values.
# In production, env vars come from compose secrets and the VPS host's
# /opt/infrastructure/secrets/formulaeapps-docker/ mount.

# Runtime environment: development | staging | production
BFF_ENV=development

# Listen port (3000 in production, matches docker-compose.yml healthcheck)
BFF_PORT=3000

# JWT shared secret used to compute/verify the client_proof HMAC (the deterrent
# that gates POST /auth/token). This value is BAKED INTO the Flutter client
# bundles via --dart-define and is therefore recoverable from the deployed web
# bundle / APK. Do NOT rely on it alone to protect session-JWT signing — set
# JWT_SIGNING_SECRET below for that.
# Generate with: openssl rand -hex 32
# In production this MUST be a real 32-byte hex value.
# Placeholder values like PLACEHOLDER_DEV_NOT_FOR_PROD are rejected at runtime.
JWT_SHARED_SECRET=replace-with-real-hex-secret

# Server-only secret used to sign/verify session JWTs (HS256). NEVER ship this
# in any client build — it stays on the BFF only. When unset, JWT signing falls
# back to JWT_SHARED_SECRET so existing deploys keep working (zero downtime);
# production logs a warning at boot until this is set. Once set, a leaked
# JWT_SHARED_SECRET can no longer be used to forge valid session JWTs.
#
# Rollout (operator, zero downtime — no client rebuild needed):
#   1. JWT_SIGNING_SECRET=$(openssl rand -hex 32)  # add to the VPS .env
#   2. docker compose up -d --force-recreate bff    # recreate the bff only
# Generate with: openssl rand -hex 32. Leave unset/blank to keep legacy behavior.
JWT_SIGNING_SECRET=

# OpenRouter API key, lives ONLY on the BFF — never in client builds
# Get from https://openrouter.ai/keys
# OpenRouter unifies access to OpenAI, Anthropic, Google, Mistral, etc. behind a
# single OpenAI-compatible endpoint. Picking a model = picking provider+model id.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Default chat model + allowlist (comma-separated)
# model_id format is `provider/model`. See https://openrouter.ai/models for the
# live catalog. Add new models to the allowlist as they ship; remove deprecated.
# Verified on OpenRouter 2026-05-19, cost-ranked cheapest→most-expensive:
#   google/gemini-2.0-flash-lite-001  google/gemini-2.0-flash-001
#   openai/gpt-4o-mini                anthropic/claude-3.5-haiku
#   anthropic/claude-haiku-4.5        openai/gpt-4o
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_ALLOWLIST=openai/gpt-4o-mini,openai/gpt-4o,anthropic/claude-3.5-haiku,anthropic/claude-haiku-4.5,google/gemini-2.0-flash-001,google/gemini-2.0-flash-lite-001

# OpenRouter attribution headers — surface this app on https://openrouter.ai/rankings
OPENROUTER_HTTP_REFERER=https://formulaeapps.com
OPENROUTER_X_TITLE=FormulaeApps

# CORS allowed origins (exact-match, no wildcards in production)
CORS_ALLOWED_ORIGINS=https://app.formulaeapps.com,https://formulaeapps.com

# Apple App Store p8 private key file (compose secret mount path)
APPLE_P8_FILE=/run/secrets/apple_p8
APPLE_ISSUER_ID=replace-with-issuer-uuid
APPLE_KEY_ID=replace-with-key-id
APPLE_BUNDLE_ID=com.capdesis.formulae

# Google Play service account file (compose secret mount path)
GOOGLE_SA_FILE=/run/secrets/google_sa
GOOGLE_PACKAGE_NAME=com.capdesis.formulae

# In-process rate limiting (defense-in-depth UNDER the Traefik
# api-ratelimit@file edge middleware). Per-IP fixed-window limits on the public
# /auth/token and JWT-gated /openai/chat routes. Defaults sit well above
# human-paced bursts; tune without a code change. Set a *_MAX to 0 to disable
# that limiter (e.g. in test environments).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_CHAT_MAX=60

# Logging
LOG_LEVEL=info
