# BFF-specific gitignore (additive to monorepo root .gitignore)

# Runtime artifacts
node_modules/
dist/
build/
.cache/

# Environment & secrets — NEVER commit
.env
.env.*
!.env.example
secrets/

# Bun
*.tsbuildinfo

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Test coverage
coverage/
*.lcov
