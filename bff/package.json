{
  "name": "formulaeapps-bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend-for-Frontend for FormulaeApps — proxies OpenAI chat, validates Apple/Google IAP receipts, issues short-lived JWTs.",
  "scripts": {
    "dev": "bun --hot run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:openapi": "bun run scripts/export-openapi.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx tsc --noEmit",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/zod-openapi": "^0.18.0",
    "zod": "^3.23.0",
    "jose": "^5.9.0",
    "@apple/app-store-server-library": "^1.4.0",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.7.0",
    "yaml": "^2.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
