{
  "name": "formulaeapps-bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend-for-Frontend for FormulaeApps — proxies OpenAI chat, validates Apple/Google IAP receipts, issues short-lived JWTs.",
  "scripts": {
    "dev": "bun --hot run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:openapi": "bun run scripts/export-openapi.ts",
    "probe:allowlist": "bun run scripts/probe-allowlist.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx tsc --noEmit",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "hono": "4.12.25",
    "@hono/zod-openapi": "1.4.0",
    "zod": "4.4.3",
    "jose": "^6.2.3",
    "@apple/app-store-server-library": "^3.1.0",
    "googleapis": "^173.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3",
    "yaml": "2.9.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
