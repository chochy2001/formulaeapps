# /public_html/app/.htaccess — servido por Hostinger en dos rutas:
#   - app.formulaeapps.com/  (subdominio, document root = /public_html/app/)
#   - formulaeapps.com/app/  (subpath del apex)
#
# Como el build de Flutter Pro usa --base-href="/" (necesario para que el
# subdominio funcione), las rutas relativas SOLO resuelven correctamente
# desde el subdominio. Por eso, si llegas vía apex, redirigimos ahí.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Apex/www → 301 al subdominio (preserva path completo)
  RewriteCond %{HTTP_HOST} ^(www\.)?formulaeapps\.com$ [NC]
  RewriteRule ^(.*)$ https://app.formulaeapps.com/$1 [R=301,L]

  # 2. Assets reales: NO SPA-fallback (404 real si falta el archivo)
  RewriteCond %{REQUEST_URI} (assets|canvaskit|icons|version)/ [OR]
  RewriteCond %{REQUEST_URI} \.(json|wasm|js|css|map|woff2?|ttf|otf|png|jpe?g|webp|avif|svg|ico|bin|txt)$
  RewriteRule ^ - [L]

  # 3. Resto (rutas SPA del router de Flutter) → /index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^.*$ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/javascript .js
  AddType application/json .json
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|wasm|css|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
