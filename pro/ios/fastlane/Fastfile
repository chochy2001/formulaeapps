default_platform(:ios)

platform :ios do
  desc "Fetch App Store signing assets with match (readonly) and pin Release to them"
  lane :certificates do
    match(
      type: "appstore",
      app_identifier: ["com.capdesis.formulaepro.3"],
      readonly: true,
    )
    # The project ships with Xcode automatic signing; point the Release build
    # configuration at the match profile so `flutter build ipa` can archive on
    # a CI runner without an Apple ID session.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      build_configurations: ["Release"],
      team_id: "W5D74488VP",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.capdesis.formulaepro.3",
    )
  end

  desc "Submit to App Store review with automatic release"
  lane :deploy_appstore do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_PRIVATE_KEY"],
      is_key_content_base64: true,
    )

    ipa_path = Dir["../build/ios/ipa/*.ipa"].first
    UI.user_error!("No IPA found under build/ios/ipa") if ipa_path.nil?

    upload_to_app_store(
      api_key: api_key,
      ipa: ipa_path,
      submit_for_review: true,
      automatic_release: true,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end
end
