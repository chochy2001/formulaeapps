---
import { SITE, SOCIAL, type Locale } from '../../consts';
import { useTranslations } from '../../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = (Astro.currentLocale ?? SITE.defaultLocale) as Locale;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const productLinks = [
  { href: getRelativeLocaleUrl(locale, '/pro'), label: t('nav.pro') },
  {
    href: getRelativeLocaleUrl(locale, locale === 'es' ? '/gratuita' : '/free'),
    label: t('nav.community'),
  },
  { href: getRelativeLocaleUrl(locale, '/soporte'), label: t('nav.support') },
];

const legalLinks = [
  { href: getRelativeLocaleUrl(locale, locale === 'es' ? '/privacidad' : '/privacy'), label: t('nav.privacy') },
  { href: getRelativeLocaleUrl(locale, locale === 'es' ? '/terminos' : '/terms'), label: t('nav.terms') },
];
---

<footer class="mt-16 border-t border-ink-100 bg-ink-50">
  <div class="mx-auto max-w-[var(--container-wide)] px-4 py-12 md:px-6">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 font-display text-xl text-primary-700">
          <span aria-hidden="true">∑</span>
          <span>{SITE.name}</span>
        </div>
        <p class="mt-3 max-w-sm text-sm text-ink-500">{t('footer.tagline')}</p>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-ink-900">{t('footer.product')}</h2>
        <ul class="mt-3 space-y-2 text-sm text-ink-500">
          {
            productLinks.map(({ href, label }) => (
              <li>
                <a href={href} class="transition-colors hover:text-primary-600">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-ink-900">{t('footer.legal')}</h2>
        <ul class="mt-3 space-y-2 text-sm text-ink-500">
          {
            legalLinks.map(({ href, label }) => (
              <li>
                <a href={href} class="transition-colors hover:text-primary-600">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>

        <h2 class="mt-6 text-sm font-semibold text-ink-900">{t('footer.contact')}</h2>
        <ul class="mt-3 space-y-2 text-sm text-ink-500">
          <li>
            <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-primary-600">
              {SITE.email}
            </a>
          </li>
          <li>
            <a
              href={SOCIAL.whatsapp}
              rel="noopener"
              target="_blank"
              class="transition-colors hover:text-primary-600"
            >
              WhatsApp
            </a>
          </li>
          <li class="flex gap-3">
            <a
              href={SOCIAL.facebook}
              rel="noopener me"
              target="_blank"
              aria-label="Facebook"
              class="hover:text-primary-600"
            >
              Facebook
            </a>
            <a
              href={SOCIAL.instagram}
              rel="noopener me"
              target="_blank"
              aria-label="Instagram"
              class="hover:text-primary-600"
            >
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-ink-200 pt-6 text-center text-xs text-ink-500">
      © {year} {SITE.publisher}. {t('footer.copyright')}
    </div>
  </div>
</footer>
