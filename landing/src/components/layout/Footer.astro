---
import { SITE, SOCIAL, type Locale } from '../../consts';
import { useTranslations } from '../../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = (Astro.currentLocale ?? SITE.defaultLocale) as Locale;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const productLinks = [
  { href: getRelativeLocaleUrl(locale, '/pro'), label: t('nav.pro') },
  {
    href: getRelativeLocaleUrl(locale, locale === 'es' ? '/gratuita' : '/free'),
    label: t('nav.community'),
  },
  { href: getRelativeLocaleUrl(locale, '/soporte'), label: t('nav.support') },
];

const legalLinks = [
  {
    href: getRelativeLocaleUrl(locale, locale === 'es' ? '/privacidad' : '/privacy'),
    label: t('nav.privacy'),
  },
  {
    href: getRelativeLocaleUrl(locale, locale === 'es' ? '/terminos' : '/terms'),
    label: t('nav.terms'),
  },
];
---

<footer class="border-ink-100 bg-ink-50 mt-16 border-t">
  <div class="mx-auto max-w-[var(--container-wide)] px-4 py-12 md:px-6">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="font-display text-primary-700 flex items-center gap-2 text-xl">
          <span aria-hidden="true">∑</span>
          <span>{SITE.name}</span>
        </div>
        <p class="text-ink-500 mt-3 max-w-sm text-sm">{t('footer.tagline')}</p>
      </div>

      <div>
        <h2 class="text-ink-900 text-sm font-semibold">{t('footer.product')}</h2>
        <ul class="text-ink-500 mt-3 space-y-2 text-sm">
          {
            productLinks.map(({ href, label }) => (
              <li>
                <a href={href} class="hover:text-primary-600 transition-colors">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-ink-900 text-sm font-semibold">{t('footer.legal')}</h2>
        <ul class="text-ink-500 mt-3 space-y-2 text-sm">
          {
            legalLinks.map(({ href, label }) => (
              <li>
                <a href={href} class="hover:text-primary-600 transition-colors">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>

        <h2 class="text-ink-900 mt-6 text-sm font-semibold">{t('footer.contact')}</h2>
        <ul class="text-ink-500 mt-3 space-y-2 text-sm">
          <li>
            <a href={`mailto:${SITE.email}`} class="hover:text-primary-600 transition-colors">
              {SITE.email}
            </a>
          </li>
          <li>
            <a
              href={SOCIAL.whatsapp}
              rel="noopener"
              target="_blank"
              class="hover:text-primary-600 transition-colors"
            >
              WhatsApp
            </a>
          </li>
          <li class="flex gap-3">
            <a
              href={SOCIAL.facebook}
              rel="noopener me"
              target="_blank"
              aria-label="Facebook"
              class="hover:text-primary-600"
            >
              Facebook
            </a>
            <a
              href={SOCIAL.instagram}
              rel="noopener me"
              target="_blank"
              aria-label="Instagram"
              class="hover:text-primary-600"
            >
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-ink-200 text-ink-500 mt-10 border-t pt-6 text-center text-xs">
      © {year}
      {SITE.publisher}. {t('footer.copyright')}
    </div>
  </div>
</footer>
