---
/**
 * Selector ES/EN. Mantiene al usuario en la página equivalente
 * usando el mapa de rutas en src/i18n/routes.ts.
 */
import { SITE, type Locale } from '../../consts';
import { useTranslations } from '../../i18n/ui';
import { translatePath } from '../../i18n/routes';

const locale = (Astro.currentLocale ?? SITE.defaultLocale) as Locale;
const t = useTranslations(locale);
---

<div class="flex items-center gap-1 rounded-full bg-ink-100 p-1 text-xs font-semibold">
  <span class="sr-only">{t('language.switcher.label')}</span>
  {
    SITE.locales.map((loc) => (
      <a
        href={translatePath(Astro.url.pathname, loc)}
        class:list={[
          'rounded-full px-3 py-1 transition-colors',
          loc === locale
            ? 'bg-white text-primary-700 shadow-soft'
            : 'text-ink-500 hover:text-ink-800',
        ]}
        aria-current={loc === locale ? 'true' : undefined}
        hreflang={loc === 'es' ? 'es-ES' : 'en-US'}
      >
        {loc.toUpperCase()}
      </a>
    ))
  }
</div>
