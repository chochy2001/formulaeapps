---
import { SITE, type Locale } from '../../consts';
import { useTranslations } from '../../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

const locale = (Astro.currentLocale ?? SITE.defaultLocale) as Locale;
const t = useTranslations(locale);

const navLinks = [
  { href: getRelativeLocaleUrl(locale, '/'), label: t('nav.home') },
  { href: getRelativeLocaleUrl(locale, '/pro'), label: t('nav.pro') },
  {
    href: getRelativeLocaleUrl(locale, locale === 'es' ? '/gratuita' : '/free'),
    label: t('nav.community'),
  },
  { href: getRelativeLocaleUrl(locale, '/soporte'), label: t('nav.support') },
];
---

<header class="border-ink-100 sticky top-0 z-40 border-b bg-white/80 backdrop-blur-md">
  <div
    class="mx-auto flex h-16 max-w-[var(--container-wide)] items-center justify-between px-4 md:px-6"
  >
    <a
      href={getRelativeLocaleUrl(locale, '/')}
      class="font-display text-primary-700 flex items-center gap-2 text-xl"
      aria-label={SITE.name}
    >
      <span aria-hidden="true">∑</span>
      <span>{SITE.name}</span>
    </a>

    <!-- Desktop nav (md+) -->
    <nav aria-label={t('nav.primaryLabel')} class="hidden md:block">
      <ul class="text-ink-700 flex items-center gap-6 text-sm font-medium">
        {
          navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="hover:text-primary-600 transition-colors"
                aria-current={Astro.url.pathname === href ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <LanguageSwitcher />
      <a
        href={SITE.appUrl}
        rel="noopener"
        target="_blank"
        class="bg-primary-600 shadow-soft hover:bg-primary-700 inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-white transition-colors max-[360px]:hidden sm:gap-2 sm:px-4 sm:py-2 sm:text-sm"
        aria-label={t('nav.openApp')}
      >
        <svg
          class="h-4 w-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 5l7 7-7 7"></path>
        </svg>
        <span>{t('nav.openApp')}</span>
      </a>

      <!-- Mobile hamburger menu (oculto en md+) -->
      <details class="group relative md:hidden" data-mobile-menu>
        <summary
          class="text-ink-700 hover:bg-ink-100 flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg transition-colors [&::-webkit-details-marker]:hidden"
          aria-label={t('nav.menuLabel')}
        >
          <!-- Hamburguesa cuando cerrado -->
          <svg
            class="h-5 w-5 group-open:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <!-- Cruz cuando abierto -->
          <svg
            class="hidden h-5 w-5 group-open:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </summary>
        <nav
          aria-label={t('nav.mobileLabel')}
          class="border-ink-100 shadow-glow absolute top-11 right-0 z-50 w-56 rounded-xl border bg-white p-2"
        >
          <ul class="text-ink-700 flex flex-col text-sm font-medium">
            {
              navLinks.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class="hover:bg-ink-50 hover:text-primary-600 aria-[current=page]:bg-primary-50 aria-[current=page]:text-primary-700 block rounded-lg px-3 py-2 transition-colors"
                    aria-current={Astro.url.pathname === href ? 'page' : undefined}
                  >
                    {label}
                  </a>
                </li>
              ))
            }
            <li class="border-ink-100 mt-1 border-t pt-1">
              <a
                href={SITE.appUrl}
                rel="noopener"
                target="_blank"
                class="hover:bg-ink-50 hover:text-primary-600 block rounded-lg px-3 py-2 transition-colors"
              >
                {t('nav.openApp')}
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Cerrar el menú móvil al hacer clic fuera o presionar Escape.
  // Los listeners se atan a `document`, que NO se reemplaza en las
  // navegaciones <ClientRouter /> (view transitions), así que persisten
  // entre páginas; `getMenu()` resuelve el <details> vigente en cada evento.
  // Por eso basta atarlos una sola vez: el guard con dataset evita
  // duplicarlos si el script llegara a re-ejecutarse (sin acumular un
  // listener `astro:page-load` por navegación).
  if (!document.documentElement.dataset.mobileMenuBound) {
    document.documentElement.dataset.mobileMenuBound = 'true';

    const getMenu = () => document.querySelector<HTMLDetailsElement>('details[data-mobile-menu]');

    document.addEventListener('click', (e) => {
      const details = getMenu();
      if (details && details.open && !details.contains(e.target as Node)) {
        details.open = false;
      }
    });
    document.addEventListener('keydown', (e) => {
      const details = getMenu();
      if (e.key === 'Escape' && details?.open) details.open = false;
    });
  }
</script>
