---
import { FEATURES, SITE, type Locale } from '../../consts';
import { useTranslations, type UIKey } from '../../i18n/ui';
import Container from '../ui/Container.astro';
import FeatureCard from './FeatureCard.astro';

const locale = (Astro.currentLocale ?? SITE.defaultLocale) as Locale;
const t = useTranslations(locale);
---

<Container as="section" class="py-16 md:py-24">
  <div class="mb-12 text-center">
    <p class="text-primary-600 text-sm font-semibold tracking-wider uppercase">
      {t('features.eyebrow')}
    </p>
    <h2 class="font-display text-ink-900 mt-3 text-3xl md:text-4xl">
      {t('features.title')}
    </h2>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
    {
      FEATURES.map((feature) => (
        <FeatureCard
          id={feature.id}
          title={t(`features.${feature.id}.title` as UIKey)}
          description={t(`features.${feature.id}.desc` as UIKey)}
          proOnly={feature.proOnly}
        />
      ))
    }
  </div>
</Container>
