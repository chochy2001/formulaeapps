---
/**
 * Galería de previews visuales de las funcionalidades.
 *
 * No usa capturas de una app localizada: el mismo SVG con notación matemática
 * y símbolos universales sirve para todos los idiomas de la landing.
 *
 * Layout:
 *   - mobile  : scroll horizontal con snap, una captura visible + peek
 *   - md+     : grid 2 columnas
 *   - lg+     : grid 5 columnas (2 filas de 5, perfecto para 10 capturas)
 *
 * El orden 01..10 corresponde a las features en `FEATURES` (consts.ts):
 *   01 Fórmulas · 02 Buscador · 03 Tareas · 04 Favoritos · 05 Imágenes
 *   06 Vídeos   · 07 Ejercicios · 08 PDFs · 09 ChatGPT · 10 Practica
 */
import { FEATURES, SITE, type Locale } from '../../consts';
import { useTranslations, type UIKey } from '../../i18n/ui';
import Container from '../ui/Container.astro';
import FormulaePreview from './FormulaePreview.astro';

const previews = FEATURES;

const locale = (Astro.currentLocale ?? SITE.defaultLocale) as Locale;
const t = useTranslations(locale);

function altFor(featureId: string | undefined): string {
  if (!featureId) return locale === 'es' ? 'Vista visual de Formulae' : 'Formulae visual preview';
  const title = t(`features.${featureId}.title` as UIKey);
  return locale === 'es'
    ? `Vista visual de Formulae: ${title.toLowerCase()}`
    : `Formulae visual preview: ${title.toLowerCase()}`;
}
---

<Container as="section" class="py-16 md:py-24">
  <div class="mb-12 text-center">
    <p class="text-primary-600 text-sm font-semibold tracking-wider uppercase">
      {t('screenshots.eyebrow')}
    </p>
    <h2 class="font-display text-ink-900 mt-3 text-3xl md:text-4xl">
      {t('screenshots.title')}
    </h2>
    <p class="text-ink-700 mx-auto mt-4 max-w-2xl">
      {t('screenshots.subtitle')}
    </p>
  </div>

  <div
    class="-mx-4 overflow-x-auto pb-6 [-ms-overflow-style:none] [scrollbar-width:none] md:mx-0 md:overflow-visible [&::-webkit-scrollbar]:hidden"
  >
    <ul
      class="flex snap-x snap-mandatory gap-4 px-4 md:grid md:snap-none md:grid-cols-2 md:gap-5 md:px-0 lg:grid-cols-5 lg:gap-6"
      role="list"
    >
      {
        previews.map((feature) => (
          <li class="w-60 shrink-0 snap-center sm:w-64 md:w-auto">
            <figure class="group relative">
              <div class="from-primary-300/50 via-primary-200/30 to-accent-400/30 absolute inset-0 -z-10 rounded-[1.75rem] bg-gradient-to-br opacity-0 blur-2xl transition duration-500 group-hover:opacity-70" />
              <FormulaePreview
                kind={feature.id}
                label={altFor(feature.id)}
                class="aspect-[9/16] w-full transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-[0_18px_42px_rgba(79,70,229,0.28)]"
              />
            </figure>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="text-ink-500 mt-4 text-center text-xs md:hidden">
    {t('screenshots.scrollHint')}
  </p>
</Container>
