---
import { SITE, STORES, type Locale } from '../../consts';
import { useTranslations } from '../../i18n/ui';
import Container from '../ui/Container.astro';

const locale = (Astro.currentLocale ?? SITE.defaultLocale) as Locale;
const t = useTranslations(locale);

const rows = [
  { label: t('comparison.feature.formulas'), pro: true, community: true },
  { label: t('comparison.feature.videos'), pro: true, community: true },
  { label: t('comparison.feature.tasks'), pro: true, community: false },
  { label: t('comparison.feature.pdf'), pro: true, community: false },
  { label: t('comparison.feature.chatgpt'), pro: true, community: false },
  { label: t('comparison.feature.adFree'), pro: true, community: false },
];
---

<Container as="section" class="py-16 md:py-24">
  <div class="mb-12 text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary-600">
      {t('comparison.eyebrow')}
    </p>
    <h2 class="mt-3 font-display text-3xl text-ink-900 md:text-4xl">
      {t('comparison.title')}
    </h2>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <!-- Pro -->
    <article
      class="relative rounded-[var(--radius-card)] border-2 border-primary-600 bg-gradient-to-br from-primary-50 to-white p-8 shadow-glow"
    >
      <span
        class="absolute -top-3 left-8 rounded-full bg-primary-600 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white"
      >
        Recomendado
      </span>
      <h3 class="font-display text-2xl text-ink-900">{t('comparison.pro.name')}</h3>
      <p class="mt-2 text-sm text-ink-700">{t('comparison.pro.tagline')}</p>
      <ul class="mt-6 space-y-2 text-sm text-ink-700">
        {rows.map((row) => (
          <li class="flex items-center gap-2">
            <span class:list={[row.pro ? 'text-primary-600' : 'text-ink-300']} aria-hidden="true">
              {row.pro ? '✓' : '—'}
            </span>
            <span class:list={[!row.pro && 'text-ink-300 line-through']}>{row.label}</span>
          </li>
        ))}
      </ul>
      <a
        href={STORES.pro.playStore}
        rel="noopener"
        target="_blank"
        class="mt-8 inline-flex w-full items-center justify-center rounded-full bg-primary-600 px-6 py-3 text-sm font-semibold text-white shadow-soft transition-colors hover:bg-primary-700"
      >
        {t('comparison.pro.cta')}
      </a>
    </article>

    <!-- Community -->
    <article
      class="rounded-[var(--radius-card)] border border-ink-200 bg-white p-8 shadow-soft"
    >
      <h3 class="font-display text-2xl text-ink-900">{t('comparison.community.name')}</h3>
      <p class="mt-2 text-sm text-ink-700">{t('comparison.community.tagline')}</p>
      <ul class="mt-6 space-y-2 text-sm text-ink-700">
        {rows.map((row) => (
          <li class="flex items-center gap-2">
            <span class:list={[row.community ? 'text-primary-600' : 'text-ink-300']} aria-hidden="true">
              {row.community ? '✓' : '—'}
            </span>
            <span class:list={[!row.community && 'text-ink-300 line-through']}>{row.label}</span>
          </li>
        ))}
      </ul>
      <a
        href={STORES.community.playStore}
        rel="noopener"
        target="_blank"
        class="mt-8 inline-flex w-full items-center justify-center rounded-full border border-ink-300 px-6 py-3 text-sm font-semibold text-ink-800 transition-colors hover:border-primary-400 hover:text-primary-700"
      >
        {t('comparison.community.cta')}
      </a>
    </article>
  </div>
</Container>
