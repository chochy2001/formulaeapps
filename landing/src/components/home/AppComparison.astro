---
import { SITE, STORES, type Locale } from '../../consts';
import { useTranslations } from '../../i18n/ui';
import Container from '../ui/Container.astro';

const locale = (Astro.currentLocale ?? SITE.defaultLocale) as Locale;
const t = useTranslations(locale);

const rows = [
  { label: t('comparison.feature.formulas'), pro: true, community: true },
  { label: t('comparison.feature.videos'), pro: true, community: true },
  { label: t('comparison.feature.tasks'), pro: true, community: false },
  { label: t('comparison.feature.pdf'), pro: true, community: false },
  { label: t('comparison.feature.chatgpt'), pro: true, community: false },
  { label: t('comparison.feature.adFree'), pro: true, community: false },
];
---

<Container as="section" class="py-16 md:py-24">
  <div class="mb-12 text-center">
    <p class="text-primary-600 text-sm font-semibold tracking-wider uppercase">
      {t('comparison.eyebrow')}
    </p>
    <h2 class="font-display text-ink-900 mt-3 text-3xl md:text-4xl">
      {t('comparison.title')}
    </h2>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <!-- Pro -->
    <article
      class="border-primary-600 from-primary-50 shadow-glow relative rounded-[var(--radius-card)] border-2 bg-gradient-to-br to-white p-8"
    >
      <span
        class="bg-primary-600 absolute -top-3 left-8 rounded-full px-3 py-1 text-[10px] font-bold tracking-wider text-white uppercase"
      >
        {t('comparison.recommended')}
      </span>
      <h3 class="font-display text-ink-900 text-2xl">{t('comparison.pro.name')}</h3>
      <p class="text-ink-700 mt-2 text-sm">{t('comparison.pro.tagline')}</p>
      <ul class="text-ink-700 mt-6 space-y-2 text-sm">
        {
          rows.map((row) => (
            <li class="flex items-center gap-2">
              <span class:list={[row.pro ? 'text-primary-600' : 'text-ink-300']} aria-hidden="true">
                {row.pro ? '✓' : '✕'}
              </span>
              <span class:list={[!row.pro && 'text-ink-300 line-through']}>{row.label}</span>
            </li>
          ))
        }
      </ul>
      <a
        href={STORES.pro.playStore}
        rel="noopener"
        target="_blank"
        class="bg-primary-600 shadow-soft hover:bg-primary-700 mt-8 inline-flex w-full items-center justify-center rounded-full px-6 py-3 text-sm font-semibold text-white transition-colors"
      >
        {t('comparison.pro.cta')}
      </a>
    </article>

    <!-- Community -->
    <article class="border-ink-200 shadow-soft rounded-[var(--radius-card)] border bg-white p-8">
      <h3 class="font-display text-ink-900 text-2xl">{t('comparison.community.name')}</h3>
      <p class="text-ink-700 mt-2 text-sm">{t('comparison.community.tagline')}</p>
      <ul class="text-ink-700 mt-6 space-y-2 text-sm">
        {
          rows.map((row) => (
            <li class="flex items-center gap-2">
              <span
                class:list={[row.community ? 'text-primary-600' : 'text-ink-300']}
                aria-hidden="true"
              >
                {row.community ? '✓' : '✕'}
              </span>
              <span class:list={[!row.community && 'text-ink-300 line-through']}>{row.label}</span>
            </li>
          ))
        }
      </ul>
      <a
        href={STORES.community.playStore}
        rel="noopener"
        target="_blank"
        class="border-ink-300 text-ink-800 hover:border-primary-400 hover:text-primary-700 mt-8 inline-flex w-full items-center justify-center rounded-full border px-6 py-3 text-sm font-semibold transition-colors"
      >
        {t('comparison.community.cta')}
      </a>
    </article>
  </div>
</Container>
