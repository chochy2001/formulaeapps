---
import FeatureIcon from '../ui/FeatureIcon.astro';
import type { FeatureId } from '../../consts';

interface Props {
  id: FeatureId;
  title: string;
  description: string;
  proOnly?: boolean;
}
const { id, title, description, proOnly = false } = Astro.props;
---

<article
  class="relative flex flex-col rounded-[var(--radius-card)] border border-ink-100 bg-white p-6 shadow-soft transition-all hover:-translate-y-1 hover:border-primary-200 hover:shadow-glow"
>
  {
    proOnly && (
      <span class="absolute right-4 top-4 rounded-full bg-accent-500/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-accent-600">
        Pro
      </span>
    )
  }
  <div
    class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-primary-100 text-primary-700"
  >
    <FeatureIcon id={id} class="h-6 w-6" />
  </div>
  <h3 class="mt-4 text-base font-semibold text-ink-900">{title}</h3>
  <p class="mt-2 text-sm text-ink-500">{description}</p>
</article>
