---
import FeatureIcon from '../ui/FeatureIcon.astro';
import type { FeatureId } from '../../consts';

interface Props {
  id: FeatureId;
  title: string;
  description: string;
  proOnly?: boolean;
}
const { id, title, description, proOnly = false } = Astro.props;
---

<article
  class="border-ink-100 shadow-soft hover:border-primary-200 hover:shadow-glow relative flex flex-col rounded-[var(--radius-card)] border bg-white p-6 transition-all hover:-translate-y-1"
>
  {
    proOnly && (
      <span class="bg-accent-500/10 text-accent-600 absolute top-4 right-4 rounded-full px-2 py-0.5 text-[10px] font-bold tracking-wider uppercase">
        Pro
      </span>
    )
  }
  <div
    class="bg-primary-100 text-primary-700 inline-flex h-11 w-11 items-center justify-center rounded-lg"
  >
    <FeatureIcon id={id} class="h-6 w-6" />
  </div>
  <h3 class="text-ink-900 mt-4 text-base font-semibold">{title}</h3>
  <p class="text-ink-500 mt-2 text-sm">{description}</p>
</article>
