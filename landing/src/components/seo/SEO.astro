---
/**
 * Componente SEO único para todas las páginas.
 * Encapsula meta tags, Open Graph, Twitter Cards, canonical y hreflang.
 *
 * Uso:
 *   <SEO title="..." description="..." image="/og/pro.png" />
 */
import { SITE, type Locale } from '../../consts';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** Path relativo SIN prefijo de locale, p.ej. "/pro". Sirve para construir alternates. */
  pathname?: string;
}

const {
  title,
  description,
  image = SITE.ogImage,
  imageAlt = SITE.name,
  noindex = false,
  pathname,
} = Astro.props;

const locale = (Astro.currentLocale ?? SITE.defaultLocale) as Locale;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogImageUrl = new URL(image, SITE.url).toString();

const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

// hreflang alternates
const alternates = pathname
  ? SITE.locales.map((loc) => ({
      hreflang: loc === 'es' ? 'es-ES' : 'en-US',
      href: new URL(getRelativeLocaleUrl(loc, pathname), SITE.url).toString(),
    }))
  : [];
---

<!-- Primary meta tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={SITE.publisher} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#4f46e5" />

<!-- Charset y viewport -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Robots -->
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large" />
  )
}

<!-- Canonical y alternates -->
<link rel="canonical" href={canonical} />
{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
{
  pathname && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getRelativeLocaleUrl(SITE.defaultLocale, pathname), SITE.url).toString()}
    />
  )
}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="mask-icon" href="/favicon.svg" color="#4f46e5" />
<link rel="manifest" href="/manifest.webmanifest" />

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />
