---
/**
 * Wrapper centrado con max-width consistente. Evita repetir
 * `mx-auto max-w-* px-4 md:px-6` en cada sección.
 */
interface Props {
  size?: 'narrow' | 'wide';
  as?: string;
  class?: string;
}
const { size = 'wide', as: Tag = 'section', class: className = '' }: Props = Astro.props;
const max = size === 'narrow' ? 'max-w-[var(--container-narrow)]' : 'max-w-[var(--container-wide)]';
---

<Tag class:list={['mx-auto px-4 md:px-6', max, className]}>
  <slot />
</Tag>
