---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import EmailLink from '../components/ui/EmailLink.astro';
import { useTranslations } from '../i18n/ui';
import { SOCIAL, LINKTREE, type Locale } from '../consts';

const locale: Locale = 'es';
const t = useTranslations(locale);

const title = 'Soporte | Formulae';
const description =
  'Centro de soporte de Formulae. Escríbenos para resolver dudas, reportar fallos o sugerir mejoras.';

const faqs = [
  {
    q: '¿Cómo recupero una compra de Formulae Pro en otro dispositivo?',
    a: 'Inicia sesión con la misma cuenta de App Store o Google Play que usaste al comprar. En la app, ve a Ajustes y pulsa "Restaurar compras".',
  },
  {
    q: '¿En qué plataformas está disponible Formulae?',
    a: 'En App Store (iOS), Google Play (Android), Microsoft Store (Windows), AppGallery (Huawei) y como ejecutable en macOS y Linux.',
  },
  {
    q: '¿Puedo descargar las fórmulas para estudiar offline?',
    a: 'Sí. Formulae Pro permite exportar formularios a PDF para imprimirlos o guardarlos. Formulae Community también genera una ficha de estudio PDF local para verla o exportarla.',
  },
  {
    q: '¿Qué diferencias hay entre Pro y Community?',
    a: 'Ambas incluyen fórmulas, vídeos, tareas y funciones PDF locales. Pro no muestra publicidad e incluye el asistente con ChatGPT; Community es gratuita y está financiada con anuncios.',
  },
];
---

<BaseLayout {title} {description} pathname="/soporte">
  <Container as="section" class="py-16 md:py-24" size="narrow">
    <h1 class="font-display text-ink-900 text-4xl md:text-5xl">{t('support.title')}</h1>
    <p class="text-ink-700 mt-4 text-lg">{t('support.subtitle')}</p>

    <div
      class="border-ink-100 shadow-soft mt-10 grid gap-4 rounded-[var(--radius-card)] border bg-white p-6 sm:grid-cols-2"
    >
      <div>
        <p class="text-ink-500 text-xs font-semibold tracking-wider uppercase">
          {t('support.email.label')}
        </p>
        <EmailLink class="text-primary-700 mt-1 block text-base font-semibold hover:underline" />
      </div>
      <div>
        <p class="text-ink-500 text-xs font-semibold tracking-wider uppercase">WhatsApp</p>
        <a
          href={SOCIAL.whatsapp}
          rel="noopener"
          target="_blank"
          class="text-primary-700 mt-1 block text-base font-semibold hover:underline"
        >
          Escríbenos por WhatsApp
        </a>
      </div>
      <div class="sm:col-span-2">
        <p class="text-ink-500 text-xs font-semibold tracking-wider uppercase">Todos los enlaces</p>
        <a
          href={LINKTREE}
          rel="noopener"
          target="_blank"
          class="text-primary-700 mt-1 block text-base font-semibold hover:underline"
        >
          linktr.ee/formulae_
        </a>
      </div>
    </div>

    <h2 class="font-display text-ink-900 mt-16 text-2xl">{t('support.faq.title')}</h2>
    <div
      class="divide-ink-100 border-ink-100 shadow-soft mt-6 divide-y rounded-[var(--radius-card)] border bg-white"
    >
      {
        faqs.map((faq) => (
          <details class="group p-5">
            <summary class="text-ink-900 group-open:text-primary-700 cursor-pointer list-none font-semibold transition-colors">
              <span class="text-primary-500 mr-2" aria-hidden="true">
                +
              </span>
              {faq.q}
            </summary>
            <p class="text-ink-700 mt-3 text-sm">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </Container>
</BaseLayout>
