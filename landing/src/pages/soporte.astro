---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { useTranslations } from '../i18n/ui';
import { SITE, SOCIAL, LINKTREE, type Locale } from '../consts';

const locale: Locale = 'es';
const t = useTranslations(locale);

const title = 'Soporte — Formulae';
const description =
  'Centro de soporte de Formulae. Escríbenos para resolver dudas, reportar fallos o sugerir mejoras.';

const faqs = [
  {
    q: '¿Cómo recupero una compra de Formulae Pro en otro dispositivo?',
    a: 'Inicia sesión con la misma cuenta de App Store o Google Play que usaste al comprar. En la app, ve a Ajustes y pulsa "Restaurar compras".',
  },
  {
    q: '¿En qué plataformas está disponible Formulae?',
    a: 'En App Store (iOS), Google Play (Android), Microsoft Store (Windows), AppGallery (Huawei) y como ejecutable en macOS y Linux.',
  },
  {
    q: '¿Puedo descargar las fórmulas para estudiar offline?',
    a: 'Sí. Formulae Pro permite exportar cualquier formulario a PDF para imprimirlo o guardarlo. Formulae Community no incluye esta función.',
  },
  {
    q: '¿Qué diferencias hay entre Pro y Community?',
    a: 'Pro no muestra publicidad, incluye lista de tareas, exportación a PDF y asistente con ChatGPT. Community es gratuita pero financiada con anuncios y sin esas funciones extra.',
  },
];
---

<BaseLayout {title} {description} pathname="/soporte">
  <Container as="section" class="py-16 md:py-24" size="narrow">
    <h1 class="font-display text-4xl text-ink-900 md:text-5xl">{t('support.title')}</h1>
    <p class="mt-4 text-lg text-ink-700">{t('support.subtitle')}</p>

    <div class="mt-10 grid gap-4 rounded-[var(--radius-card)] border border-ink-100 bg-white p-6 shadow-soft sm:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">
          {t('support.email.label')}
        </p>
        <a
          href={`mailto:${SITE.email}`}
          class="mt-1 block text-base font-semibold text-primary-700 hover:underline"
        >
          {SITE.email}
        </a>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">WhatsApp</p>
        <a
          href={SOCIAL.whatsapp}
          rel="noopener"
          target="_blank"
          class="mt-1 block text-base font-semibold text-primary-700 hover:underline"
        >
          Escríbenos por WhatsApp
        </a>
      </div>
      <div class="sm:col-span-2">
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">
          Todos los enlaces
        </p>
        <a
          href={LINKTREE}
          rel="noopener"
          target="_blank"
          class="mt-1 block text-base font-semibold text-primary-700 hover:underline"
        >
          linktr.ee/formulae_
        </a>
      </div>
    </div>

    <h2 class="mt-16 font-display text-2xl text-ink-900">{t('support.faq.title')}</h2>
    <div class="mt-6 divide-y divide-ink-100 rounded-[var(--radius-card)] border border-ink-100 bg-white shadow-soft">
      {
        faqs.map((faq) => (
          <details class="group p-5">
            <summary class="cursor-pointer list-none font-semibold text-ink-900 transition-colors group-open:text-primary-700">
              <span class="mr-2 text-primary-500" aria-hidden="true">
                +
              </span>
              {faq.q}
            </summary>
            <p class="mt-3 text-sm text-ink-700">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </Container>
</BaseLayout>
