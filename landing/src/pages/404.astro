---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { useTranslations } from '../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

const t = useTranslations('es');
---

<BaseLayout title={t('404.title')} description={t('404.subtitle')} noindex>
  <Container as="section" class="grid place-items-center py-24 text-center" size="narrow">
    <p class="font-display text-primary-600 text-7xl">404</p>
    <h1 class="font-display text-ink-900 mt-4 text-3xl">{t('404.title')}</h1>
    <p class="text-ink-700 mt-3">{t('404.subtitle')}</p>
    <a
      href={getRelativeLocaleUrl('es', '/')}
      class="bg-primary-600 shadow-soft hover:bg-primary-700 mt-8 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold text-white transition-colors"
    >
      {t('404.cta')}
    </a>
  </Container>
</BaseLayout>
