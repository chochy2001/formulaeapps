---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Features from '../components/home/Features.astro';
import DownloadCTA from '../components/home/DownloadCTA.astro';
import { useTranslations } from '../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { STORES, type Locale } from '../consts';

const locale: Locale = 'es';
const t = useTranslations(locale);

const title = 'Formulae Community, versión gratuita';
const description =
  'Formulae Community es la versión gratuita de Formulae. Catálogo completo de fórmulas matemáticas y científicas con vídeos e imágenes explicativas, financiada con publicidad.';
---

<BaseLayout {title} {description} pathname="/gratuita" schema="community">
  <Container as="section" class="py-16 md:py-24">
    <p class="text-primary-600 text-sm font-semibold tracking-wider uppercase">
      Formulae Community
    </p>
    <h1 class="font-display text-ink-900 mt-3 max-w-3xl text-4xl md:text-5xl">
      Aprende matemáticas y ciencias gratis.
    </h1>
    <p class="text-ink-700 mt-6 max-w-2xl text-lg">
      {t('comparison.community.tagline')}
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={STORES.community.playStore}
        rel="noopener"
        target="_blank"
        class="bg-primary-600 shadow-soft hover:bg-primary-700 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold text-white transition-colors"
      >
        {t('comparison.community.cta')}
      </a>
      <a
        href={STORES.community.appStore}
        rel="noopener"
        target="_blank"
        class="border-ink-200 text-ink-800 hover:border-primary-400 hover:text-primary-700 inline-flex items-center gap-2 rounded-full border bg-white px-6 py-3 text-sm font-semibold transition-colors"
      >
        {t('download.appStore')}
      </a>
    </div>

    <p class="text-ink-500 mt-10 max-w-2xl text-sm">
      {t('free.upsell.text')}{' '}
      <a
        href={getRelativeLocaleUrl(locale, '/pro')}
        class="text-primary-600 font-semibold hover:underline">{t('free.upsell.cta')}</a
      >.
    </p>
  </Container>

  <Features />
  <DownloadCTA variant="community" />
</BaseLayout>
