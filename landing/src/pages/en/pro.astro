---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Features from '../../components/home/Features.astro';
import DownloadCTA from '../../components/home/DownloadCTA.astro';
import { useTranslations } from '../../i18n/ui';
import { STORES } from '../../consts';

const t = useTranslations('en');

const title = 'Formulae Pro — Ad-free with AI assistant';
const description =
  'Formulae Pro is the ad-free version of Formulae. PDF export, task list, ChatGPT-powered assistant and more. Available for iOS, Android, Windows, macOS and Linux.';
---

<BaseLayout {title} {description} pathname="/pro" schema="pro">
  <Container as="section" class="py-16 md:py-24">
    <p class="text-primary-600 text-sm font-semibold tracking-wider uppercase">Formulae Pro</p>
    <h1 class="font-display text-ink-900 mt-3 max-w-3xl text-4xl md:text-5xl">
      All the power of Formulae, ad-free and AI-powered.
    </h1>
    <p class="text-ink-700 mt-6 max-w-2xl text-lg">{t('comparison.pro.tagline')}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={STORES.pro.playStore}
        rel="noopener"
        target="_blank"
        class="bg-primary-600 shadow-soft hover:bg-primary-700 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold text-white transition-colors"
      >
        {t('comparison.pro.cta')}
      </a>
      <a
        href={STORES.pro.appStore}
        rel="noopener"
        target="_blank"
        class="border-ink-200 text-ink-800 hover:border-primary-400 hover:text-primary-700 inline-flex items-center gap-2 rounded-full border bg-white px-6 py-3 text-sm font-semibold transition-colors"
      >
        {t('download.appStore')}
      </a>
    </div>
  </Container>
  <Features />
  <DownloadCTA variant="pro" />
</BaseLayout>
