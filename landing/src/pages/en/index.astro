---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import VideoDemo from '../../components/home/VideoDemo.astro';
import Features from '../../components/home/Features.astro';
import Subjects from '../../components/home/Subjects.astro';
import AppScreenshots from '../../components/home/AppScreenshots.astro';
import AppComparison from '../../components/home/AppComparison.astro';
import DownloadCTA from '../../components/home/DownloadCTA.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('en');
---

<BaseLayout
  title={`${t('hero.title')} — Formulae`}
  description={t('hero.subtitle')}
  pathname="/"
  schema="both"
  includeVideo
>
  <Hero />
  <VideoDemo />
  <Features />
  <AppScreenshots />
  <AppComparison />
  <Subjects />
  <DownloadCTA variant="both" />
</BaseLayout>
