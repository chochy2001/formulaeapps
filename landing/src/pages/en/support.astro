---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import EmailLink from '../../components/ui/EmailLink.astro';
import { useTranslations } from '../../i18n/ui';
import { SOCIAL, LINKTREE } from '../../consts';

const t = useTranslations('en');

const title = 'Support | Formulae';
const description =
  'Formulae support center. Reach out to ask a question, report a bug or suggest an improvement.';

const faqs = [
  {
    q: 'How do I restore my Formulae Pro purchase on another device?',
    a: 'Sign in with the same App Store or Google Play account you used to purchase. Open the app, go to Settings and tap "Restore purchases".',
  },
  {
    q: 'Which platforms is Formulae available on?',
    a: 'App Store (iOS), Google Play (Android), Microsoft Store (Windows), AppGallery (Huawei) and as desktop builds for macOS and Linux.',
  },
  {
    q: 'Can I download formulas to study offline?',
    a: 'Yes. Formulae Pro lets you export any formula sheet to PDF for printing or saving. Formulae Community does not include this feature.',
  },
  {
    q: 'What is the difference between Pro and Community?',
    a: 'Pro removes ads and adds tasks, PDF export and a ChatGPT-powered assistant. Community is free but ad-supported and lacks those extras.',
  },
];
---

<BaseLayout {title} {description} pathname="/support">
  <Container as="section" class="py-16 md:py-24" size="narrow">
    <h1 class="font-display text-ink-900 text-4xl md:text-5xl">{t('support.title')}</h1>
    <p class="text-ink-700 mt-4 text-lg">{t('support.subtitle')}</p>

    <div
      class="border-ink-100 shadow-soft mt-10 grid gap-4 rounded-[var(--radius-card)] border bg-white p-6 sm:grid-cols-2"
    >
      <div>
        <p class="text-ink-500 text-xs font-semibold tracking-wider uppercase">
          {t('support.email.label')}
        </p>
        <EmailLink class="text-primary-700 mt-1 block text-base font-semibold hover:underline" />
      </div>
      <div>
        <p class="text-ink-500 text-xs font-semibold tracking-wider uppercase">WhatsApp</p>
        <a
          href={SOCIAL.whatsapp}
          rel="noopener"
          target="_blank"
          class="text-primary-700 mt-1 block text-base font-semibold hover:underline"
        >
          Reach us on WhatsApp
        </a>
      </div>
      <div class="sm:col-span-2">
        <p class="text-ink-500 text-xs font-semibold tracking-wider uppercase">All links</p>
        <a
          href={LINKTREE}
          rel="noopener"
          target="_blank"
          class="text-primary-700 mt-1 block text-base font-semibold hover:underline"
        >
          linktr.ee/formulae_
        </a>
      </div>
    </div>

    <h2 class="font-display text-ink-900 mt-16 text-2xl">{t('support.faq.title')}</h2>
    <div
      class="divide-ink-100 border-ink-100 shadow-soft mt-6 divide-y rounded-[var(--radius-card)] border bg-white"
    >
      {
        faqs.map((faq) => (
          <details class="group p-5">
            <summary class="text-ink-900 group-open:text-primary-700 cursor-pointer list-none font-semibold transition-colors">
              <span class="text-primary-500 mr-2" aria-hidden="true">
                +
              </span>
              {faq.q}
            </summary>
            <p class="text-ink-700 mt-3 text-sm">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </Container>
</BaseLayout>
