---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import { useTranslations } from '../../i18n/ui';
import { SITE, SOCIAL, LINKTREE } from '../../consts';

const t = useTranslations('en');

const title = 'Support — Formulae';
const description =
  'Formulae support center. Reach out to ask a question, report a bug or suggest an improvement.';

const faqs = [
  {
    q: 'How do I restore my Formulae Pro purchase on another device?',
    a: 'Sign in with the same App Store or Google Play account you used to purchase. Open the app, go to Settings and tap "Restore purchases".',
  },
  {
    q: 'Which platforms is Formulae available on?',
    a: 'App Store (iOS), Google Play (Android), Microsoft Store (Windows), AppGallery (Huawei) and as desktop builds for macOS and Linux.',
  },
  {
    q: 'Can I download formulas to study offline?',
    a: 'Yes. Formulae Pro lets you export any formula sheet to PDF for printing or saving. Formulae Community does not include this feature.',
  },
  {
    q: 'What is the difference between Pro and Community?',
    a: 'Pro removes ads and adds tasks, PDF export and a ChatGPT-powered assistant. Community is free but ad-supported and lacks those extras.',
  },
];
---

<BaseLayout {title} {description} pathname="/support">
  <Container as="section" class="py-16 md:py-24" size="narrow">
    <h1 class="font-display text-4xl text-ink-900 md:text-5xl">{t('support.title')}</h1>
    <p class="mt-4 text-lg text-ink-700">{t('support.subtitle')}</p>

    <div class="mt-10 grid gap-4 rounded-[var(--radius-card)] border border-ink-100 bg-white p-6 shadow-soft sm:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">
          {t('support.email.label')}
        </p>
        <a
          href={`mailto:${SITE.email}`}
          class="mt-1 block text-base font-semibold text-primary-700 hover:underline"
        >
          {SITE.email}
        </a>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">WhatsApp</p>
        <a
          href={SOCIAL.whatsapp}
          rel="noopener"
          target="_blank"
          class="mt-1 block text-base font-semibold text-primary-700 hover:underline"
        >
          Reach us on WhatsApp
        </a>
      </div>
      <div class="sm:col-span-2">
        <p class="text-xs font-semibold uppercase tracking-wider text-ink-500">All links</p>
        <a
          href={LINKTREE}
          rel="noopener"
          target="_blank"
          class="mt-1 block text-base font-semibold text-primary-700 hover:underline"
        >
          linktr.ee/formulae_
        </a>
      </div>
    </div>

    <h2 class="mt-16 font-display text-2xl text-ink-900">{t('support.faq.title')}</h2>
    <div class="mt-6 divide-y divide-ink-100 rounded-[var(--radius-card)] border border-ink-100 bg-white shadow-soft">
      {
        faqs.map((faq) => (
          <details class="group p-5">
            <summary class="cursor-pointer list-none font-semibold text-ink-900 transition-colors group-open:text-primary-700">
              <span class="mr-2 text-primary-500" aria-hidden="true">
                +
              </span>
              {faq.q}
            </summary>
            <p class="mt-3 text-sm text-ink-700">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </Container>
</BaseLayout>
