---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Features from '../../components/home/Features.astro';
import DownloadCTA from '../../components/home/DownloadCTA.astro';
import { useTranslations } from '../../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { STORES } from '../../consts';

const t = useTranslations('en');

const title = 'Formulae Community, free version';
const description =
  'Formulae Community is the free version of Formulae. Complete catalog of math and science formulas with explanatory videos and images, supported by ads.';
---

<BaseLayout
  {title}
  {description}
  pathname="/free"
  schema="community"
  image="/og/community.png"
  imageAlt="Formulae Community"
>
  <Container as="section" class="py-16 md:py-24">
    <p class="text-primary-600 text-sm font-semibold tracking-wider uppercase">
      Formulae Community
    </p>
    <h1 class="font-display text-ink-900 mt-3 max-w-3xl text-4xl md:text-5xl">
      Learn maths and science for free.
    </h1>
    <p class="text-ink-700 mt-6 max-w-2xl text-lg">{t('comparison.community.tagline')}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={STORES.community.playStore}
        rel="noopener"
        target="_blank"
        class="bg-primary-600 shadow-soft hover:bg-primary-700 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold text-white transition-colors"
      >
        {t('comparison.community.cta')}
      </a>
      <a
        href={STORES.community.appStore}
        rel="noopener"
        target="_blank"
        class="border-ink-200 text-ink-800 hover:border-primary-400 hover:text-primary-700 inline-flex items-center gap-2 rounded-full border bg-white px-6 py-3 text-sm font-semibold transition-colors"
      >
        {t('download.appStore')}
      </a>
    </div>

    <p class="text-ink-500 mt-10 max-w-2xl text-sm">
      {t('free.upsell.text')}{' '}
      <a
        href={getRelativeLocaleUrl('en', '/pro')}
        class="text-primary-600 font-semibold hover:underline">{t('free.upsell.cta')}</a
      >.
    </p>
  </Container>
  <Features />
  <DownloadCTA variant="community" />
</BaseLayout>
