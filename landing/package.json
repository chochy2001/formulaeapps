{
  "name": "formulae-landing",
  "type": "module",
  "version": "1.0.1",
  "private": true,
  "description": "Landing page oficial de Formulae Apps (Pro y Community)",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "og": "node scripts/generate-og.mjs",
    "favicons": "node scripts/generate-favicons.mjs",
    "recover:formulae-images": "bun scripts/recover-formulae-spanish-images.mjs --force && bun scripts/neutralize-formulae-image-language.mjs",
    "neutralize:formulae-images": "bun scripts/neutralize-formulae-image-language.mjs",
    "check:formulae-images": "bun scripts/validate-formulae-images.mjs --scope=all",
    "check:formulae-images:canonical": "bun scripts/validate-formulae-images.mjs --scope=canonical",
    "check:formulae-images:remote": "bun scripts/verify-formulae-image-urls.mjs --scope=all",
    "check:localized-marketing": "node scripts/validate-localized-marketing.mjs",
    "lint": "astro check && prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "^7.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "^4.0.0",
    "yaml": "^2.9.0"
  }
}
