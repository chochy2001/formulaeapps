default_platform(:android)

platform :android do
  desc "Deploy to Google Play production track"
  lane :deploy_production do
    upload_to_play_store(
      track: "production",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      package_name: "capdesis.formulae",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Fail if the pubspec versionCode already exists on Google Play"
  lane :guard_version_code do |options|
    build_number = options[:build_number].to_i
    UI.user_error!("build_number is required and must be positive") if build_number <= 0

    tracks = %w[production internal]
    used_codes = tracks.flat_map do |t|
      google_play_track_version_codes(
        track: t,
        json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
        package_name: "capdesis.formulae",
      )
    end
    if used_codes.include?(build_number)
      UI.user_error!(
        "versionCode #{build_number} ya existe en Google Play (tracks #{tracks.join(' + ')}). " \
        "Play no permite re-publicar un versionCode: bumpa la version en community/pubspec.yaml y mergea de nuevo."
      )
    else
      UI.success("versionCode #{build_number} disponible en Google Play.")
    end
  end
end
